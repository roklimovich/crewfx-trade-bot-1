generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Roles as a table (not a bare enum) so permissions can evolve without a migration.
model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())
  users       User[]

  @@map("roles")
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  emailVerified        DateTime?
  passwordHash         String
  name                 String?
  status               UserStatus            @default(PENDING)
  roleId               String
  twoFactorEnabled     Boolean               @default(false)
  twoFactorSecret      String?
  locale               String                @default("en")
  referredById         String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  adminActionsTaken    AdminAction[]         @relation("AdminActor")
  adminActionsOn       AdminAction[]         @relation("AdminTarget")
  logs                 Log[]
  notifications        Notification[]
  pocketOptionAccounts PocketOptionAccount[]
  pushSubscriptions    PushSubscription[]
  sessions             Session[]
  settingsUpdated      Setting[]
  telegramAccount      TelegramAccount?
  referredBy           User?                 @relation("Referrals", fields: [referredById], references: [id])
  referrals            User[]                @relation("Referrals")
  role                 Role                  @relation(fields: [roleId], references: [id])
  verificationTokens   VerificationToken[]

  @@index([status])
  @@index([roleId])
  @@map("users")
}

/// Refresh-token sessions — lets admins revoke a specific device/session.
model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Users submit a Pocket Option account ID for verification/binding — never credentials.
model PocketOptionAccount {
  id          String    @id @default(cuid())
  userId      String
  accountId   String
  verified    Boolean   @default(false)
  submittedAt DateTime  @default(now())
  verifiedAt  DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
  @@index([verified])
  @@map("pocket_option_accounts")
}

model TelegramAccount {
  id         String   @id @default(cuid())
  userId     String   @unique
  telegramId String   @unique
  username   String?
  chatId     String   @unique
  linkedAt   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_accounts")
}

/// Raw OHLCV candles per pair + timeframe. This is the source of truth the
/// signal engine and indicator calculations read from.
model MarketData {
  id        String    @id @default(cuid())
  pair      String
  timeframe Timeframe
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float     @default(0)
  timestamp DateTime
  createdAt DateTime  @default(now())

  @@unique([pair, timeframe, timestamp])
  @@index([pair, timeframe, timestamp])
  @@map("market_data")
}

/// Calculated indicator values, snapshotted per pair/timeframe/time so the
/// signal engine (and later audits) can see exactly what data justified a signal.
model Indicator {
  id        String        @id @default(cuid())
  pair      String
  timeframe Timeframe
  type      IndicatorType
  /// Flexible payload: a single float for RSI/ATR, or a structured object for
  /// multi-value indicators (MACD: {macd, signal, histogram}; Bollinger: {upper, middle, lower}).
  value     Json
  timestamp DateTime
  createdAt DateTime      @default(now())
  signals   Signal[]      @relation("SignalIndicators")

  @@unique([pair, timeframe, type, timestamp])
  @@index([pair, timeframe, type])
  @@map("indicators")
}

model Signal {
  id               String          @id @default(cuid())
  pair             String
  direction        SignalDirection
  entryPrice       Float
  confidenceScore  Float
  expirationTime   DateTime
  technicalSummary String
  riskLevel        RiskLevel
  timeframe        Timeframe
  status           SignalStatus    @default(PENDING)
  engineVersion    String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  aiAnalyses       AIAnalysis[]
  notifications    Notification[]
  history          SignalHistory?
  indicatorsUsed   Indicator[]     @relation("SignalIndicators")

  @@index([pair, createdAt])
  @@index([status])
  @@map("signals")
}

/// Outcome tracking, kept separate from Signal so the signal record stays
/// immutable (what was predicted) vs. history (what actually happened).
model SignalHistory {
  id         String        @id @default(cuid())
  signalId   String        @unique
  outcome    SignalOutcome @default(PENDING)
  closePrice Float?
  pnlPips    Float?
  closedAt   DateTime?
  createdAt  DateTime      @default(now())
  signal     Signal        @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@index([outcome])
  @@index([closedAt])
  @@map("signal_history")
}

/// LLM-generated, human-readable explanation of a rule-based signal.
/// Never the source of the signal itself — see Phase 9.
/// One row PER LOCALE per signal (Phase 13 addition) — `locale` + the compound unique below is
/// what makes "AI descriptions translated to whichever language is selected" possible, since a
/// single generated-once English explanation can't serve a Russian-reading user honestly.
model AIAnalysis {
  id                 String   @id @default(cuid())
  signalId           String
  locale             String   @default("en")
  summary            String
  reasoning          String
  riskHighlights     String
  confidenceEstimate Float
  model              String
  createdAt          DateTime @default(now())
  signal             Signal   @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@unique([signalId, locale])
  @@map("ai_analyses")
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  signalId  String?
  channel   NotificationChannel
  title     String
  body      String
  status    NotificationStatus  @default(PENDING)
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime            @default(now())
  signal    Signal?             @relation(fields: [signalId], references: [id])
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([signalId])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model Log {
  id        String   @id @default(cuid())
  level     LogLevel
  message   String
  context   Json?
  userId    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([level, createdAt])
  @@index([userId])
  @@map("logs")
}

/// Global, admin-editable key/value app settings (feature flags, thresholds, etc.)
model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation(fields: [updatedById], references: [id])

  @@map("settings")
}

model AdminAction {
  id           String          @id @default(cuid())
  adminId      String
  actionType   AdminActionType
  targetUserId String?
  notes        String?
  createdAt    DateTime        @default(now())
  admin        User            @relation("AdminActor", fields: [adminId], references: [id], onDelete: Cascade)
  targetUser   User?           @relation("AdminTarget", fields: [targetUserId], references: [id])

  @@index([adminId, createdAt])
  @@index([targetUserId])
  @@map("admin_actions")
}

/// Single-use, revocable tokens for email verification and password reset.
/// We store only a hash of the token (never the raw value) — same pattern as Session.refreshTokenHash.
model VerificationToken {
  id        String                @id @default(cuid())
  userId    String
  tokenHash String                @unique
  type      VerificationTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

enum RoleName {
  ADMIN
  MODERATOR
  USER
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  BLOCKED
}

enum SignalDirection {
  BUY
  SELL
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum SignalStatus {
  PENDING
  ACTIVE
  EXPIRED
  WON
  LOST
  CANCELLED
}

enum SignalOutcome {
  PENDING
  WIN
  LOSS
  BREAK_EVEN
}

enum IndicatorType {
  RSI
  EMA
  SMA
  MACD
  ATR
  ADX
  CCI
  VWAP
  BOLLINGER_BANDS
  STOCHASTIC
  PIVOT_POINTS
}

enum Timeframe {
  M1
  M5
  M15
  M30
  H1
  H4
  D1
}

enum NotificationChannel {
  EMAIL
  TELEGRAM
  PUSH
  BROWSER
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum LogLevel {
  INFO
  WARN
  ERROR
  SECURITY
}

enum AdminActionType {
  APPROVE_USER
  REJECT_USER
  BLOCK_USER
  UNBLOCK_USER
  CHANGE_ROLE
  UPDATE_SETTING
  DELETE_SIGNAL
  IMPERSONATE
  VERIFY_POCKET_OPTION
  KICK_USER
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

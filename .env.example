# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/signalforge?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/signalforge?schema=public"

# --- Bootstrap admin (created by `npm run db:seed` if both are set — see prisma/seed.ts) ---
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# --- Redis (cache, rate limiting, pub/sub for real-time signals) ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL=http://localhost:3000

# --- Email ---
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="SignalForge <no-reply@example.com>"

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# --- Market Data Provider (use an official/licensed API — configure per your data agreement) ---
MARKET_DATA_API_KEY=""
MARKET_DATA_BASE_URL="https://api.twelvedata.com"
CRON_SECRET=""

# --- AI Analysis ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Push Notifications (Web Push / VAPID) ---
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# --- Rate limiting / security ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
